DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth
APP_HOST=localhost
APP_PORT=8000
# Number of proxies in front of the server (e.g. 1 behind a load balancer), so rate limits see the real client IP
# TRUST_PROXY=1

# Rate limit buckets; leave unset to keep them in memory (single instance only)
REDIS_URL=redis://localhost:6379

# Generate these with: npm run keys
JWT_PRIVATE_KEY_PATH=./src/keys/jwt.private.pem
JWT_PUBLIC_KEY_PATH=./src/keys/jwt.public.pem
REFRESH_PEPPER_PATH=./src/keys/refresh.pepper.txt

# SMTP for the verification email (an Ethereal test account works)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Auth Server" <no-reply@example.com>
